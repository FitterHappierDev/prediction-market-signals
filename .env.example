# PM Signal Platform — environment variable template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Prediction-market data sources ----
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret

# ---- Polygon RPC (for on-chain wallet tracing) ----
ALCHEMY_API_KEY=your_alchemy_api_key

# ---- Brokers ----
# Alpaca paper-trading credentials (used until Phase 6 go-live)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_API_SECRET=your_alpaca_paper_secret

# ---- Notifications ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---- Infrastructure ----
# Set by docker-compose.yml for the Grafana container
GRAFANA_PASSWORD=choose_a_strong_password

# Public IP of the EC2 instance (used in Grafana root URL, SSH tunneling, etc.)
SERVER_IP=your_elastic_ip

# Optional: S3 bucket for QuestDB backups. Leave empty to disable S3 sync.
S3_BACKUP_BUCKET=

# ---- Feature flag overrides (optional — uppercase mirrors settings.yaml) ----
# PAPER_MODE=true
# STAGE2_ENABLED=false
# EXECUTION_ENABLED=false
# CRYPTO_ENABLED=false
# WALLET_TRACING_ENABLED=true
# CROSS_PLATFORM_REQUIRED=false
# SELF_TRAINING_ENABLED=false
